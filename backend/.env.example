# OpenRouter credentials for the shared LLM client
OPENROUTER_API_KEY=
# Model slug as listed by OpenRouter, e.g. vendor/model-name
OPENROUTER_MODEL=

# Bind address for the API. Defaults to 127.0.0.1 (localhost only).
# HOST=127.0.0.1
# Setting HOST=0.0.0.0 exposes the API to your LAN — do this only if you intend to.
